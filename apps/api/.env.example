# Enable or disable optional LLM enrichment.
SALES_AGENT_LLM_ENABLED=true
SALES_AGENT_LLM_PROVIDER=openai_compatible

# Required when LLM enrichment is enabled.
# Use an OpenAI-compatible Chat Completions endpoint.
SALES_AGENT_LLM_BASE_URL=
SALES_AGENT_LLM_API_KEY=
SALES_AGENT_LLM_MODEL=

# Never commit a real .env file or API key.

# Local runtime defaults.
SALES_AGENT_RUNTIME_DIR=runtime
SALES_AGENT_DATABASE_URL=sqlite:///./sales_analysis_agent.db

# Optional reliability controls.
SALES_AGENT_LLM_COMPLETION_TIMEOUT_SECONDS=60
SALES_AGENT_LLM_COMPLETION_WALL_TIMEOUT_SECONDS=90
SALES_AGENT_LLM_MAX_ATTEMPTS=3
SALES_AGENT_LLM_CACHE_ENABLED=true
SALES_AGENT_LLM_CACHE_DIR=runtime/llm_cache
SALES_AGENT_LLM_PROFILE=quick
